<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Fixed, shared across ALL RouteGo services: one secrets.json per developer, one entry per
         service (each key is its own secret name), kept apart from any other platform's store. -->
    <UserSecretsId>routego</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- test files are co-located on disk but compiled into {Project}.Tests (references/test-compilation.md) -->
    <Compile Remove="Features/**/*.Tests.cs" />
    <Compile Remove="Infrastructure/**/*.Tests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Non-secret settings from SSM Parameter Store outside Development (Infrastructure/ParameterStoreConfiguration.cs). -->
    <PackageReference Include="Amazon.Extensions.Configuration.SystemsManager" Version="*" />
    <!-- Standard AWS Secrets Manager access — baked into every project (references/secrets.md). -->
    <PackageReference Include="AWSSDK.SecretsManager.Caching" Version="*" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="*" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="*" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.16" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- OpenAPI + Scalar API docs (references/host-components.md) — one-time setup. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="*" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <!-- Microsoft.OpenApi as a RANGE, not a pinned minor. Two constraints have to hold at once:
         at least what Microsoft.AspNetCore.OpenApi above needs (it floats, and its floor rises —
         10.0.12 requires 2.12), and below 3.0, whose API surface ResponseHeadersTransformer is not
         written against (2.x puts the models in the Microsoft.OpenApi namespace and makes
         OpenApiSchema.Type the JsonSchemaType enum). A fixed minor can only express the ceiling, so
         `2.7.*` became a DOWNGRADE the moment the floating parent's floor passed it — NU1605 is
         warning-as-error here, so a freshly stamped project would not restore, build or scan. The
         range lets NuGet satisfy the parent without a hand-edit, and still refuses 3.x.
         The floor also stays clear of 2.0.0, which carries advisory NU1903 (high). -->
    <PackageReference Include="Microsoft.OpenApi" Version="[2.12.2,3.0)" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="*" />
    <!-- Transport / data-access (or the UI "Backend" client) packages are added
         by the sibling slice skill, NOT here. -->
  </ItemGroup>

</Project>
